# Настройки резервного копирования вне сервера (restic + S3-хранилище).
# Скопируйте в /root/.pihta-backup.env и выполните: chmod 600 /root/.pihta-backup.env
#
# Пример для Yandex Object Storage (бакет pihta-backups):
RESTIC_REPOSITORY=s3:https://storage.yandexcloud.net/pihta-backups/calendar
# Статический ключ доступа сервисного аккаунта с ролью storage.editor:
AWS_ACCESS_KEY_ID=ваш-идентификатор-ключа
AWS_SECRET_ACCESS_KEY=ваш-секретный-ключ
# Пароль шифрования копий. СОХРАНИТЕ ЕГО ОТДЕЛЬНО (менеджер паролей, бумага в сейфе):
# без него восстановить копии невозможно — ни вам, ни кому-либо ещё.
# Сгенерировать: openssl rand -base64 32
RESTIC_PASSWORD=длинный-случайный-пароль
