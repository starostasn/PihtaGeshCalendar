# Основной адрес — DOMAIN; дополнительные (например, www) — EXTRA_DOMAINS через пробел.
# Сертификаты Let's Encrypt выпускаются для всех адресов, дополнительные перенаправляются на основной.
{$DOMAIN} {$EXTRA_DOMAINS} {
	@other not host {$DOMAIN}
	redir @other https://{$DOMAIN}{uri} permanent

	encode gzip
	# Не сообщать, на каком ПО работает сервер (ни Caddy, ни gunicorn)
	header -Server
	reverse_proxy web:8000
}
