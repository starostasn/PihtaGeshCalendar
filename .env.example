# Домен сервиса (A-запись должна указывать на IP сервера)
DOMAIN=calendar.example.ru
# Дополнительные адреса через пробел (например, www.example.ru) — с них будет перенаправление на DOMAIN.
# Для каждого нужна A-запись на IP сервера.
EXTRA_DOMAINS=

# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=замените-на-длинную-случайную-строку
DEBUG=0
TIME_ZONE=Europe/Moscow

# Telegram-уведомления (необязательно, см. README)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Как часто забирать календари площадок, секунд
SYNC_INTERVAL_SECONDS=600

# API Авито (ключи приложения с developers.avito.ru → «Мои приложения»).
# Не пересылайте их в мессенджерах и не кладите в репозиторий — только сюда, в .env на сервере.
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
